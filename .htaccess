# Ludino — Apache / LiteSpeed config for Hostinger shared hosting.
# Static site: no build, no server-side code.

DirectoryIndex index.html
Options -Indexes

# ---------------------------------------------------------------- HTTPS ----
# Hostinger issues a free SSL certificate; this makes sure everyone uses it.
# Enable SSL in hPanel FIRST, or this will redirect to a broken certificate.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------- MIME types ----
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType image/x-icon                .ico
  AddType application/manifest+json   .webmanifest
</IfModule>

# ---------------------------------------------------------- compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --------------------------------------------------------------- cache -----
# Filenames are NOT content-hashed (styles.css, not styles.a1b2c3.css), so
# these are deliberately short. A long cache would leave returning visitors
# on a stale stylesheet after an update.
<IfModule mod_expires.c>
  ExpiresActive On

  # Always revalidate HTML so content changes appear immediately
  ExpiresByType text/html                 "access plus 0 seconds"

  ExpiresByType text/css                  "access plus 1 day"
  ExpiresByType application/javascript    "access plus 1 day"

  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Light hardening — no framing, no MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------ housekeeping -
# These ship in the repo but should never be served publicly.
<FilesMatch "^(README\.md|serve\.py|\.gitignore|\.nojekyll)$">
  Require all denied
</FilesMatch>
